<p style="color: green"><%= notice %></p>

<%= render @color %>
<img src="/uploads/macouleur<%=@color.id%>/<%=@pic%>"/>

<div>
  <%= link_to "show a pic of the color", color_path(@color.id, showpic: "true") %>
  <%= link_to "Edit this color", edit_color_path(@color) %> |
  <%= link_to "Back to colors", colors_path %>

  <%= button_to "Destroy this color", @color, method: :delete %>
</div>
