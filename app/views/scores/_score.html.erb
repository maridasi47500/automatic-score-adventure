<div id="<%= dom_id score %>">
  <p>
    <strong>Title:</strong>
    <%= score.title %>
  </p>

  <p>
    <strong>Composer:</strong>
    <%= score.composer %>
  </p>

  <p>
    <strong>Time signature:</strong>
    <%= score.time_signature %>
  </p>

  <p>
    <strong>Key signature:</strong>
    <%= score.key_signature %>
  </p>

  <p>
    <strong>Content:</strong>
    <%= score.content %>
  </p>

  <p>
    <strong>Adventure description:</strong>
    <%= score.adventure_description %>
  </p>

</div>
